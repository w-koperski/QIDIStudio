FOUND_GTK3=$(pacman -Q gtk3 2>/dev/null || true)

REQUIRED_DEV_PACKAGES=(
    base-devel
    cmake
    ninja
    extra-cmake-modules
    file
    gettext
    git
    wget
    curl
    gstreamer
    gst-plugins-base
    gst-plugins-good
    gst-plugins-bad
    gst-libav
    libsecret
    mesa
    glu
    openssl
    eglexternalplatform
    dbus
    glew
    systemd-libs
    libmspack
    gtk3
    libxkbcommon
    libtool
    libunwind
    fuse2
    texinfo
    nasm
    yasm
    x264
    bzip2
    wayland
    wayland-protocols
    cairo
)

if [[ -n "$UPDATE_LIB" ]]
then
    REQUIRED_DEV_PACKAGES+=(webkit2gtk-4.1)
    if [[ -n "$BUILD_DEBUG" ]]
    then
        REQUIRED_DEV_PACKAGES+=(openssl curl)
    fi

    NEEDED_PKGS=()
    for PKG in "${REQUIRED_DEV_PACKAGES[@]}"; do
        pacman -Q "${PKG}" >/dev/null 2>&1 || NEEDED_PKGS+=("${PKG}")
    done

    if [ ${#NEEDED_PKGS[@]} -gt 0 ]; then
        sudo pacman -S --needed --noconfirm "${NEEDED_PKGS[@]}"
    fi
    echo -e "done\n"
    exit 0
fi

FOUND_GTK3_DEV=$(pacman -Q gtk3 2>/dev/null || true)
